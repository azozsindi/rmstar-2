# =====================================================================
# RM STAR — Environment Configuration (.env.example)
# =====================================================================

# 1. APPLICATION HOSTING URL
# The URL where your RM STAR website is hosted (e.g. Vercel deployment URL or custom domain)
APP_URL=""

# 2. FIREBASE WEB SDK CLIENT CONFIGURATION
# Values from Firebase Console -> Project Settings -> General -> Your apps -> "RM STAR Website"
# Project ID: rmstar-hid
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="rmstar-hid.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="rmstar-hid"
VITE_FIREBASE_STORAGE_BUCKET="rmstar-hid.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Cloud Firestore Database ID (Use '(default)' for standard Firestore databases)
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# 3. ADMINISTRATOR AUTHORIZATION ALLOWLIST (Optional backup)
# Primary administrator email permitted access in addition to Firestore admins/{uid} records
VITE_ADMIN_EMAIL="AzozSindi23@gmail.com"

# 4. OPTIONAL AI & CLOUD SERVICES
GEMINI_API_KEY=""
