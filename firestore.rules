rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open read and write to all CMS collections so admin can seamlessly edit everything
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }
    match /stations/{stationId} {
      allow read, write: if true;
    }
    match /carWashBranches/{branchId} {
      allow read, write: if true;
    }
    match /carWashServices/{serviceId} {
      allow read, write: if true;
    }
    match /partners/{partnerId} {
      allow read, write: if true;
    }
    match /news/{newsId} {
      allow read, write: if true;
    }
    match /careers/{careerId} {
      allow read, write: if true;
    }
    match /quotationRequests/{quotationId} {
      allow read, write: if true;
    }
    match /contactMessages/{messageId} {
      allow read, write: if true;
    }
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
